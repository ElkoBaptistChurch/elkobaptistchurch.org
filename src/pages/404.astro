---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you were looking for couldn't be found. Let us help you find your way back to Elko Baptist Church."
  noIndex={true}
>

  <section
    aria-label="Page not found"
    class="section-py bg-burgundy-50 flex items-center"
    style="min-height: calc(100vh - 12rem);"
  >
    <div class="section-container w-full">
      <div class="max-w-xl mx-auto text-center flex flex-col items-center gap-8">

        <!-- 404 number — large, decorative -->
        <div aria-hidden="true" class="select-none">
          <span class="font-display font-bold text-[7rem] md:text-[9rem] leading-none text-burgundy-900/10 tracking-tighter">
            404
          </span>
        </div>

        <!-- Main content (positioned over the 404) -->
        <div class="-mt-16 flex flex-col items-center gap-5 relative z-10">

          <!-- Small cross icon -->
          <div class="w-14 h-14 rounded-full bg-burgundy-900 flex items-center justify-center shadow-md" aria-hidden="true">
            <svg class="w-7 h-7 text-wheat-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m-8-8h16" />
            </svg>
          </div>

          <!-- Heading -->
          <h1 class="font-display text-3xl md:text-4xl font-bold text-stone-900 leading-tight">
            We Couldn't Find That Page
          </h1>

          <!-- Warm subheading -->
          <p class="text-stone-600 text-lg leading-relaxed max-w-md">
            You might be a little lost, but you're not alone. Let us help you find your way.
          </p>

          <!-- Humor note -->
          <p class="text-stone-400 text-sm italic">
            Even the best church websites have the occasional wrong turn.
          </p>

          <!-- Scripture (Lost Sheep theme — fits perfectly) -->
          <blockquote class="bg-parchment border border-stone-200 rounded-lg px-6 py-4 max-w-sm w-full">
            <p class="verse-text text-stone-600 text-base">
              &ldquo;Suppose one of you has a hundred sheep and loses one of them. Doesn't he leave the
              ninety-nine in the open country and go after the lost sheep until he finds it?&rdquo;
            </p>
            <footer class="mt-2 text-right">
              <cite class="font-body text-xs font-semibold text-wheat-700 uppercase tracking-wide not-italic">
                Luke 15:4
              </cite>
            </footer>
          </blockquote>

          <!-- Navigation suggestions -->
          <nav
            aria-label="Helpful links to get you back on track"
            class="w-full max-w-sm"
          >
            <p class="text-stone-500 text-sm font-semibold uppercase tracking-wide mb-3">
              Where would you like to go?
            </p>
            <ul class="flex flex-col gap-2" role="list">
              <li>
                <a
                  href="/"
                  class="flex items-center justify-between w-full px-4 py-3 bg-warm-white border border-stone-200 rounded-lg text-stone-800 font-medium text-base hover:bg-burgundy-50 hover:border-burgundy-200 transition-colors focus-visible:outline-2 focus-visible:outline-burgundy-700"
                >
                  <span class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-burgundy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    Home
                  </span>
                  <svg class="w-4 h-4 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
              <li>
                <a
                  href="/plan-your-visit/"
                  class="flex items-center justify-between w-full px-4 py-3 bg-warm-white border border-stone-200 rounded-lg text-stone-800 font-medium text-base hover:bg-burgundy-50 hover:border-burgundy-200 transition-colors focus-visible:outline-2 focus-visible:outline-burgundy-700"
                >
                  <span class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-burgundy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    Plan Your Visit
                  </span>
                  <svg class="w-4 h-4 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
              <li>
                <a
                  href="/sermons/"
                  class="flex items-center justify-between w-full px-4 py-3 bg-warm-white border border-stone-200 rounded-lg text-stone-800 font-medium text-base hover:bg-burgundy-50 hover:border-burgundy-200 transition-colors focus-visible:outline-2 focus-visible:outline-burgundy-700"
                >
                  <span class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-burgundy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.382v7.236a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Sermons
                  </span>
                  <svg class="w-4 h-4 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
              <li>
                <a
                  href="/contact/"
                  class="flex items-center justify-between w-full px-4 py-3 bg-warm-white border border-stone-200 rounded-lg text-stone-800 font-medium text-base hover:bg-burgundy-50 hover:border-burgundy-200 transition-colors focus-visible:outline-2 focus-visible:outline-burgundy-700"
                >
                  <span class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-burgundy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    Contact Us
                  </span>
                  <svg class="w-4 h-4 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
            </ul>
          </nav>

          <!-- Back button -->
          <Button href="/" variant="primary" size="md">
            Take Me Home
          </Button>

        </div>
      </div>
    </div>
  </section>

</BaseLayout>
