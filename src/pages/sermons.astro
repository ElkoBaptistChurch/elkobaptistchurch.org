---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import SermonCard from '@/components/ui/SermonCard.astro';
import SermonRow from '@/components/ui/SermonRow.astro';
import SermonFilter from '@/components/ui/SermonFilter.astro';
import { siteConfig } from '@/data/site';
import {
  sortByDateDesc,
  toCardProps,
  getBookFacets,
  getTopicFacets,
} from '@/utils/sermons';
import { webPageSchema, buildCanonical } from '@/utils/seo';

const pageTitle = 'Sermons';
const pageDescription =
  'Weekly sermons from Pastor Wayne Holcomb at Elko Baptist Church in Elko, GA, Houston County — live-streamed every Sunday at 11:00 AM on YouTube.';

const schema = webPageSchema({
  title: pageTitle,
  description: pageDescription,
  url: buildCanonical('/sermons/'),
  breadcrumbs: [{ name: 'Sermons', url: buildCanonical('/sermons/') }],
});

const allSermons = sortByDateDesc(await getCollection('sermons'));
const latestSermon = toCardProps(allSermons[0]);

// Archive discovery: hero cards (top matches) + a paginated row list below.
const archiveSermons = allSermons.map(toCardProps);
const bookFacets = getBookFacets(allSermons);
const topicFacets = getTopicFacets(allSermons);

const HERO_COUNT = 6;
const DEFAULT_PAGE_SIZE = 15;
// Initial server-rendered visibility (JS takes over after load): first 6 show as
// hero cards, the next page of rows shows below; the rest are present but hidden.
const initiallyVisible = (i: number) =>
  i >= HERO_COUNT && i < HERO_COUNT + DEFAULT_PAGE_SIZE;
---

<BaseLayout
  title="Sermons"
  description={pageDescription}
  schema={schema}
>
  <!-- ====================================================
       HERO
  ===================================================== -->
  <section
    aria-label="Sermons page hero"
    class="bg-burgundy-950 relative overflow-hidden"
  >
    <!-- Decorative texture -->
    <div class="absolute inset-0 opacity-5" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--color-burgundy-700)_0%,_transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--color-wheat-900)_0%,_transparent_60%)]"></div>
    </div>

    <div class="relative z-10 section-container py-24 md:py-32">
      <div class="max-w-3xl">
        <SectionHeading
          label="From the Pulpit"
          heading="Sermons"
          subheading="Week after week, Pastor Wayne opens God's Word and brings it to life for our community in Elko, Georgia — and for anyone watching from wherever they are."
          as="h1"
          light={true}
        />

        <p class="text-burgundy-200 text-lg leading-relaxed mt-6 mb-8 max-w-2xl">
          Every Sunday Morning Worship is live-streamed at <strong class="text-warm-white">11:00 AM</strong> on YouTube.
          If you can't be with us in person, you can always join us online.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <Button
            href={siteConfig.social.youtube}
            variant="secondary"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Watch on YouTube
          </Button>
          <Button
            href="#recent-messages"
            variant="outline"
            size="lg"
            class="border-warm-white/60 text-warm-white hover:bg-warm-white/10 hover:border-warm-white"
          >
            Browse All Messages
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
       LATEST / FEATURED SERMON
  ===================================================== -->
  <section
    aria-labelledby="latest-sermon-heading"
    class="section-py bg-cream"
  >
    <div class="section-container">
      <div class="mb-10">
        <SectionHeading
          label="Latest Message"
          heading="This Week's Sermon"
          subheading="Pastor Wayne preaches verse-by-verse through God's Word. Here's the most recent message from the pulpit."
          as="h2"
        />
      </div>

      <!-- Featured sermon card with embedded player -->
      <div class="max-w-5xl">
        <article
          class="bg-warm-white rounded-xl border border-stone-200 overflow-hidden shadow-sm"
          aria-label={`Featured sermon: ${latestSermon.title}`}
        >
          <div class="grid lg:grid-cols-2 gap-0">
            <!-- Video embed column -->
            <div class="relative bg-gradient-to-br from-burgundy-800 to-burgundy-950">
              {latestSermon.youtubeId ? (
                <div class="aspect-video lg:aspect-auto lg:h-full">
                  <iframe
                    src={`https://www.youtube.com/embed/${latestSermon.youtubeId}${latestSermon.startSeconds ? `?start=${latestSermon.startSeconds}` : ''}`}
                    title={latestSermon.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    class="w-full h-full"
                    loading="lazy"
                  ></iframe>
                </div>
              ) : (
                <div class="relative aspect-video lg:aspect-auto lg:h-full flex items-center justify-center min-h-[280px]">
                  <img
                    src="/images/Pastor-Wayne-Bible.jpg"
                    alt="Pastor Wayne Holcomb preaching from the Bible"
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-burgundy-950/40"></div>
                  <div class="relative w-16 h-16 rounded-full bg-wheat-500/90 flex items-center justify-center shadow-lg">
                    <svg class="w-7 h-7 text-burgundy-950 ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              )}
              {latestSermon.duration && (
                <div class="absolute bottom-3 right-3 bg-burgundy-950/80 text-warm-white text-xs font-body font-semibold px-2 py-1 rounded backdrop-blur-sm">
                  {latestSermon.duration}
                </div>
              )}
            </div>

            <!-- Text column -->
            <div class="p-8 md:p-10 flex flex-col justify-center">
              <h3 class="font-display text-3xl md:text-4xl font-bold text-stone-900 leading-tight mb-4">
                {latestSermon.title}
              </h3>

              <!-- Scripture badge -->
              <div class="inline-flex items-center gap-1.5 mb-5">
                <svg class="w-4 h-4 text-wheat-600 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                <span class="text-wheat-700 text-sm font-body font-semibold">{latestSermon.scripture}</span>
              </div>

              <!-- Date + speaker -->
              <p class="text-stone-500 text-sm font-body mb-5">
                <time datetime={latestSermon.date} class="font-semibold text-stone-700">
                  {new Date(latestSermon.date + 'T00:00:00').toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span class="mx-1.5 text-stone-300" aria-hidden="true">&bull;</span>
                <span>{latestSermon.speaker}</span>
              </p>

              <p class="text-stone-600 text-base leading-relaxed mb-8 line-clamp-5">
                {latestSermon.description}
              </p>

              <div class="flex flex-col sm:flex-row gap-3">
                <Button
                  href={latestSermon.youtubeId
                    ? `https://www.youtube.com/watch?v=${latestSermon.youtubeId}${latestSermon.startSeconds ? `&t=${latestSermon.startSeconds}s` : ''}`
                    : `/sermons/${latestSermon.id}/`}
                  variant="primary"
                  size="md"
                  target={latestSermon.youtubeId ? '_blank' : undefined}
                  rel={latestSermon.youtubeId ? 'noopener noreferrer' : undefined}
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  Watch This Message
                </Button>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ====================================================
       THE ARCHIVE — hero cards + paginated, searchable list
  ===================================================== -->
  <section
    id="recent-messages"
    aria-labelledby="archive-heading"
    class="section-py bg-cream"
  >
    <div class="section-container">
      <div class="mb-8">
        <SectionHeading
          label="The Archive"
          heading="Every Message"
          subheading="We're whole-Bible believers — Pastor Wayne preaches straight through the text. Search for a passage, or browse by book and topic."
          as="h2"
        />
      </div>

      {archiveSermons.length > 0 ? (
        <>
          <SermonFilter bookFacets={bookFacets} topicFacets={topicFacets} />

          <!-- Hero cards: most recent, or top matches for the active filter -->
          <section id="sermon-heroes-section" class="mb-12" aria-label="Featured sermons">
            <div class="flex items-end justify-between gap-4 mb-5">
              <h3 id="sermon-hero-label" class="font-display text-2xl font-bold text-burgundy-900">Most Recent</h3>
              <span id="sermon-hero-hint" class="text-stone-400 text-sm"></span>
            </div>
            <div id="sermon-heroes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
              {archiveSermons.slice(0, HERO_COUNT).map((sermon) => (
                <SermonCard sermon={sermon} featured={false} />
              ))}
            </div>
          </section>

          <!-- Paginated message list -->
          <section id="sermon-list-section" aria-label="Sermon archive">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-burgundy-900 pb-3">
              <h3 id="sermon-list-label" class="font-display text-2xl font-bold text-burgundy-900">Earlier Messages</h3>
              <div class="flex items-center gap-2 text-sm text-stone-500">
                <label for="sermon-size">Per page</label>
                <select id="sermon-size" class="bg-warm-white border border-stone-300 rounded-sm px-2 py-1.5 text-stone-800 focus-visible:outline-2 focus-visible:outline-burgundy-700">
                  <option value="15">15</option>
                  <option value="30">30</option>
                  <option value="50">50</option>
                </select>
              </div>
            </div>
            <p id="sermon-count" class="text-stone-500 text-sm py-3" aria-live="polite"></p>
            <div id="sermon-list">
              {archiveSermons.map((sermon, i) => (
                <SermonRow sermon={sermon} hidden={!initiallyVisible(i)} />
              ))}
            </div>
            <nav id="sermon-pager" class="flex flex-wrap items-center justify-center gap-1.5 mt-8" aria-label="Sermon pages"></nav>
          </section>

          <p id="sermon-empty" hidden class="text-center text-stone-500 py-16 text-lg">
            No messages match. Try a different passage, topic, or search.
          </p>
        </>
      ) : (
        <div class="text-center py-16">
          <p class="text-stone-500 text-lg">More sermons coming soon. Check back after each Sunday.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ====================================================
       SUBSCRIBE / FOLLOW CTA
  ===================================================== -->
  <section
    aria-labelledby="subscribe-heading"
    class="bg-burgundy-900 relative overflow-hidden"
  >
    <div
      class="absolute inset-0 opacity-15 bg-[radial-gradient(ellipse_at_top_left,_var(--color-wheat-700)_0%,_transparent_60%)]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 section-container section-py">
      <div class="max-w-2xl mx-auto text-center">
        <span class="eyebrow text-wheat-400 mb-4 block">Stay Connected</span>
        <h2
          id="subscribe-heading"
          class="font-display text-4xl md:text-5xl font-bold text-warm-white leading-tight mb-6"
        >
          Never Miss a Message
        </h2>
        <p class="text-burgundy-100 text-lg md:text-xl leading-relaxed mb-4">
          Subscribe on YouTube and you'll get notified every time a new sermon is posted.
          We go live every <strong class="text-warm-white">Sunday at 11:00 AM</strong> — and the recording is up shortly after.
        </p>
        <p class="text-burgundy-200 text-base leading-relaxed mb-10">
          You can watch from home, share a message with a friend, or catch up on anything you missed.
          The pulpit is always open.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button
            href={siteConfig.social.youtube}
            variant="secondary"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Subscribe on YouTube
          </Button>
          <Button
            href="/plan-your-visit/"
            variant="outline"
            size="lg"
            class="border-warm-white/60 text-warm-white hover:bg-warm-white/10 hover:border-warm-white"
          >
            Visit Us in Person
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
