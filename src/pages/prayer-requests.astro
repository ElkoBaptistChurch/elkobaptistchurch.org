---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { siteConfig } from '@/data/site';
---

<!--
  Prayer requests page — noIndex=true (private, pastoral content)
  Form submission requires Cloudflare Pages Functions or Formspree — see README.
  Static fallback: action="mailto:elkobaptistchurch@gmail.com"
-->
<BaseLayout
  title="Prayer Requests"
  description="Submit a prayer request to the Elko Baptist Church prayer team. We believe prayer moves mountains — bring your needs and we will lift them before God."
  noIndex={true}
>

  <!-- ============================================================
       PAGE HERO
       ============================================================ -->
  <section
    aria-label="Prayer requests page header"
    class="relative bg-burgundy-950 overflow-hidden section-py"
  >
    <!-- Soft radial glow for warmth -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_center,_rgba(180,83,9,0.15)_0%,_transparent_65%)]" aria-hidden="true"></div>

    <div class="relative z-10 section-container">
      <div class="max-w-2xl">
        <SectionHeading
          label="Prayer & Intercession"
          heading="Submit a Prayer Request"
          subheading="We believe prayer moves mountains. Whatever you're carrying — big or small — bring it to us. We'll lift it to God."
          as="h1"
          light={true}
        />
      </div>
    </div>
  </section>

  <!-- ============================================================
       SCRIPTURE CONTEXT
       ============================================================ -->
  <section
    aria-label="Scripture and pastoral note"
    class="bg-parchment border-b border-stone-200 py-12 md:py-16"
  >
    <div class="section-container">
      <div class="max-w-2xl mx-auto text-center flex flex-col items-center gap-6">

        <!-- Verse -->
        <blockquote class="flex flex-col gap-4">
          <p class="verse-text text-stone-700">
            &ldquo;Do not be anxious about anything, but in every situation, by prayer and petition,
            with thanksgiving, present your requests to God. And the peace of God, which transcends
            all understanding, will guard your hearts and your minds in Christ Jesus.&rdquo;
          </p>
          <footer>
            <cite class="font-body font-semibold text-wheat-700 text-sm not-italic tracking-wide uppercase">
              Philippians 4:6&ndash;7
            </cite>
          </footer>
        </blockquote>

        <!-- Decorative rule -->
        <span class="section-rule bg-wheat-500 mx-auto" aria-hidden="true"></span>

        <!-- Pastoral note -->
        <p class="text-stone-600 text-base leading-relaxed max-w-xl">
          At Elko Baptist, we pray together as a church family. Your request will be shared
          with our prayer team and lifted before God every week. Nothing is too big. Nothing
          is too small. You are not alone.
        </p>

      </div>
    </div>
  </section>

  <!-- ============================================================
       PRAYER REQUEST FORM
       ============================================================ -->
  <section
    aria-label="Prayer request form"
    class="section-py bg-cream"
  >
    <div class="section-container">
      <div class="max-w-2xl mx-auto">

        <div class="bg-warm-white rounded-xl border border-stone-200 p-6 md:p-10 shadow-sm">

          <h2 class="font-display text-2xl font-bold text-stone-900 mb-2">
            Share Your Request
          </h2>
          <p class="text-stone-500 text-sm mb-8">
            You may remain completely anonymous if you prefer. What matters is that we pray.
          </p>

          <!--
            Real form submission requires Cloudflare Pages Functions or Formspree — see README.
            Static fallback: action="mailto:elkobaptistchurch@gmail.com"
          -->
          <form
            method="POST"
            action="/api/prayer"
            novalidate
            class="flex flex-col gap-6"
          >

            <!-- Name (optional) -->
            <div class="flex flex-col gap-1.5">
              <label for="prayer-name" class="font-body font-medium text-stone-800 text-sm">
                Your Name
                <span class="text-stone-400 font-normal text-xs ml-1">(optional — you may remain anonymous)</span>
              </label>
              <input
                type="text"
                id="prayer-name"
                name="name"
                autocomplete="name"
                placeholder="First name, or leave blank"
                class="w-full px-4 py-3 text-stone-900 bg-cream border border-stone-300 rounded-sm text-base
                       focus:outline-none focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700
                       placeholder:text-stone-400 transition-colors"
              />
            </div>

            <!-- Prayer request (required) -->
            <div class="flex flex-col gap-1.5">
              <label for="prayer-request" class="font-body font-medium text-stone-800 text-sm">
                Your Prayer Request <span class="text-wheat-700" aria-label="required">*</span>
              </label>
              <textarea
                id="prayer-request"
                name="request"
                required
                rows="7"
                placeholder="Share what's on your heart. You can be as brief or as detailed as you'd like. This is a safe place."
                class="w-full px-4 py-3 text-stone-900 bg-cream border border-stone-300 rounded-sm text-base
                       focus:outline-none focus:ring-2 focus:ring-burgundy-700 focus:border-burgundy-700
                       placeholder:text-stone-400 transition-colors resize-y min-h-[160px]"
              ></textarea>
            </div>

            <!-- Sharing preference -->
            <fieldset class="flex flex-col gap-3">
              <legend class="font-body font-medium text-stone-800 text-sm">
                Sharing Preference
              </legend>
              <div class="flex flex-col gap-2">
                <label class="flex items-start gap-3 cursor-pointer group">
                  <input
                    type="radio"
                    name="sharing"
                    value="prayer-team-only"
                    checked
                    class="mt-1 w-4 h-4 text-burgundy-800 border-stone-300 focus:ring-burgundy-700 accent-burgundy-800 cursor-pointer"
                  />
                  <span class="flex flex-col">
                    <span class="font-medium text-stone-800 text-sm">Prayer team only</span>
                    <span class="text-stone-500 text-xs leading-relaxed">
                      Shared privately with our small prayer team. Not read aloud or posted publicly.
                    </span>
                  </span>
                </label>
                <label class="flex items-start gap-3 cursor-pointer group">
                  <input
                    type="radio"
                    name="sharing"
                    value="congregation"
                    class="mt-1 w-4 h-4 text-burgundy-800 border-stone-300 focus:ring-burgundy-700 accent-burgundy-800 cursor-pointer"
                  />
                  <span class="flex flex-col">
                    <span class="font-medium text-stone-800 text-sm">Share with our congregation</span>
                    <span class="text-stone-500 text-xs leading-relaxed">
                      May be included in our weekly prayer list shared with the church family.
                    </span>
                  </span>
                </label>
              </div>
            </fieldset>

            <!-- Submit -->
            <div class="flex flex-col gap-4 pt-1">
              <Button variant="primary" size="md" type="submit">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                Submit Prayer Request
              </Button>

              <!-- Privacy reassurance -->
              <p class="text-stone-500 text-sm leading-relaxed">
                Your request is never sold or shared outside our church — only with the prayer team or congregation based on the sharing option you choose above.
              </p>

              <!-- Warm confirmation note -->
              <p class="text-stone-500 text-sm leading-relaxed italic">
                After submitting, know that someone is praying for you right now.
              </p>
            </div>

          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW WE PRAY
       ============================================================ -->
  <section
    aria-label="How the Elko Baptist prayer team prays"
    class="section-py bg-burgundy-900"
  >
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <SectionHeading
          label="Our Commitment"
          heading="How We Pray"
          centered={true}
          light={true}
          class="mb-10"
        />

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

          <div class="flex flex-col items-center text-center gap-3">
            <div class="w-12 h-12 rounded-full bg-burgundy-800 border border-burgundy-700 flex items-center justify-center text-wheat-400 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display font-bold text-warm-white text-base mb-1">
                A Dedicated Prayer Team
              </h3>
              <p class="text-burgundy-200 text-sm leading-relaxed">
                Every week, our prayer team gathers to lift up every request by name. Your need does not go unheard.
              </p>
            </div>
          </div>

          <div class="flex flex-col items-center text-center gap-3">
            <div class="w-12 h-12 rounded-full bg-burgundy-800 border border-burgundy-700 flex items-center justify-center text-wheat-400 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <h3 class="font-display font-bold text-warm-white text-base mb-1">
                Sunday Morning Worship
              </h3>
              <p class="text-burgundy-200 text-sm leading-relaxed">
                We lift up prayer requests together during worship each week. Join us Sundays at 11:00 AM.
              </p>
            </div>
          </div>

          <div class="flex flex-col items-center text-center gap-3">
            <div class="w-12 h-12 rounded-full bg-burgundy-800 border border-burgundy-700 flex items-center justify-center text-wheat-400 flex-shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display font-bold text-warm-white text-base mb-1">
                Pray in Person
              </h3>
              <p class="text-burgundy-200 text-sm leading-relaxed">
                You're always welcome to come and pray with us in person. Pastor {siteConfig.pastor.name} and our church family are here for you.
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       PRAYER RESOURCES
       ============================================================ -->
  <section
    aria-label="Scripture encouragement"
    class="py-12 md:py-16 bg-cream"
  >
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display text-2xl font-bold text-stone-800 mb-8 text-center">
          Words to Hold Onto
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

          <div class="bg-parchment rounded-lg border border-stone-200 p-6 text-center flex flex-col gap-4">
            <p class="verse-text text-stone-600 text-base leading-relaxed">
              &ldquo;Do not fear, for I am with you; do not be dismayed, for I am your God.&rdquo;
            </p>
            <cite class="font-body text-sm font-semibold text-wheat-700 uppercase tracking-wide not-italic">
              Isaiah 41:10
            </cite>
          </div>

          <div class="bg-parchment rounded-lg border border-stone-200 p-6 text-center flex flex-col gap-4">
            <p class="verse-text text-stone-600 text-base leading-relaxed">
              &ldquo;God is our refuge and strength, an ever-present help in trouble.&rdquo;
            </p>
            <cite class="font-body text-sm font-semibold text-wheat-700 uppercase tracking-wide not-italic">
              Psalm 46:1
            </cite>
          </div>

          <div class="bg-parchment rounded-lg border border-stone-200 p-6 text-center flex flex-col gap-4">
            <p class="verse-text text-stone-600 text-base leading-relaxed">
              &ldquo;And we know that in all things God works for the good of those who love him.&rdquo;
            </p>
            <cite class="font-body text-sm font-semibold text-wheat-700 uppercase tracking-wide not-italic">
              Romans 8:28
            </cite>
          </div>

          <div class="bg-parchment rounded-lg border border-stone-200 p-6 text-center flex flex-col gap-4">
            <p class="verse-text text-stone-600 text-base leading-relaxed">
              &ldquo;And my God will supply every need of yours according to his riches in glory in Christ Jesus.&rdquo;
            </p>
            <cite class="font-body text-sm font-semibold text-wheat-700 uppercase tracking-wide not-italic">
              Philippians 4:19
            </cite>
          </div>

        </div>
      </div>
    </div>
  </section>

</BaseLayout>
