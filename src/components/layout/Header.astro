---
import { siteConfig } from '@/data/site';

const navLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Ministries', href: '/ministries/' },
  { label: 'Sermons', href: '/sermons/' },
  { label: 'Staff', href: '/staff/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-warm-white/95 backdrop-blur-sm border-b border-stone-200 shadow-sm">
  <div class="section-container">
    <div class="flex items-center justify-between h-18 md:h-20">

      <!-- Wordmark / Logo -->
      <a
        href="/"
        class="flex items-center gap-3 group focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-burgundy-700 rounded-sm"
        aria-label={`${siteConfig.name} — Home`}
      >
        <!-- Logo emblem -->
        <img
          src="/images/logo.png"
          alt=""
          aria-hidden="true"
          width="44"
          height="44"
          class="flex-shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full transition-opacity duration-200 group-hover:opacity-80"
        />
        <div class="flex flex-col leading-none">
          <span class="font-display font-bold text-burgundy-950 text-lg md:text-xl group-hover:text-burgundy-700 transition-colors duration-200">
            Elko Baptist
          </span>
          <span class="font-body text-xs text-stone-500 tracking-wide">
            Church · Elko, Georgia
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Main navigation" class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class={`
              px-3 py-2 rounded-sm font-body font-medium text-[0.9375rem] transition-colors duration-150
              focus-visible:outline-2 focus-visible:outline-burgundy-700
              ${isActive(link.href)
                ? 'text-burgundy-900 font-semibold'
                : 'text-stone-600 hover:text-burgundy-900 hover:bg-burgundy-50'
              }
            `}
          >
            {link.label}
          </a>
        ))}

        <!-- CTA Button -->
        <a
          href="/plan-your-visit/"
          class="ml-3 px-5 py-2.5 bg-burgundy-900 text-warm-white font-body font-semibold text-[0.9375rem] rounded-sm hover:bg-burgundy-800 active:bg-burgundy-950 transition-colors duration-150 shadow-sm focus-visible:outline-2 focus-visible:outline-burgundy-700"
        >
          Plan Your Visit
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
        class="lg:hidden flex items-center justify-center w-11 h-11 text-stone-700 hover:text-burgundy-900 hover:bg-burgundy-50 rounded-sm transition-colors focus-visible:outline-2 focus-visible:outline-burgundy-700"
      >
        <svg id="menu-open-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="menu-close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-stone-200 bg-warm-white"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <nav class="section-container py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`
            px-4 py-3 rounded-sm font-body font-medium text-base transition-colors
            ${isActive(link.href)
              ? 'text-burgundy-900 bg-burgundy-50 font-semibold'
              : 'text-stone-700 hover:text-burgundy-900 hover:bg-burgundy-50'
            }
          `}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/plan-your-visit/"
        class="mt-3 px-4 py-3 bg-burgundy-900 text-warm-white font-body font-semibold text-base rounded-sm hover:bg-burgundy-800 transition-colors text-center"
      >
        Plan Your Visit
      </a>
      <a
        href="/prayer-requests/"
        class="px-4 py-3 text-stone-600 font-body text-base hover:text-burgundy-900 hover:bg-burgundy-50 rounded-sm transition-colors"
      >
        Prayer Requests
      </a>
    </nav>

    <!-- Service times quick view in mobile menu -->
    <div class="border-t border-stone-100 bg-burgundy-50">
      <div class="section-container py-3">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-widest mb-2">Service Times</p>
        <div class="flex flex-wrap gap-x-6 gap-y-1">
          {siteConfig.serviceTimes.map((s) => (
            <span class="text-sm text-stone-700">
              <strong class="font-semibold text-burgundy-900">{s.day}</strong> {s.time}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>
