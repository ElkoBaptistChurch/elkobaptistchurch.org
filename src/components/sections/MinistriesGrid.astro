---
import { featuredMinistries } from '@/data/ministries';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
---

<section
  aria-label="Our ministries"
  class="bg-warm-white section-py"
>
  <div class="section-container">

    <!-- Heading -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
      <SectionHeading
        label="Grow With Us"
        heading="Ministries for Every Season of Life"
        subheading="Whether you're raising little ones, seeking deeper roots, or just looking for a place to belong — there's a place for you here."
        class="max-w-2xl"
      />
      <a
        href="/ministries/"
        class="flex-shrink-0 text-burgundy-700 font-semibold hover:text-burgundy-900 transition-colors underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-burgundy-700 whitespace-nowrap"
      >
        See All Ministries &rarr;
      </a>
    </div>

    <!-- Ministry cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {featuredMinistries.map((ministry) => (
        <Card
          href={`/ministries/#${ministry.id}`}
          hoverable
          padded
          background="parchment"
          class="flex flex-col gap-5"
        >
          <!-- Icon -->
          <div
            class="w-14 h-14 rounded-lg bg-burgundy-900 flex items-center justify-center flex-shrink-0"
            aria-hidden="true"
          >
            {ministry.icon === 'music' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-wheat-400">
                <path d="M9 18V5l12-2v13"/>
                <circle cx="6" cy="18" r="3"/>
                <circle cx="18" cy="16" r="3"/>
              </svg>
            )}
            {ministry.icon === 'book' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-wheat-400">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            )}
            {ministry.icon === 'children' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-wheat-400">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            )}
            <!-- Fallback icon for any others -->
            {!['music', 'book', 'children'].includes(ministry.icon) && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-wheat-400">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4l3 3"/>
              </svg>
            )}
          </div>

          <!-- Content -->
          <div class="flex flex-col gap-2 flex-1">
            <h3 class="font-display text-xl font-bold text-stone-900 leading-snug">
              {ministry.name}
            </h3>
            <p class="text-stone-600 leading-relaxed">
              {ministry.shortDescription}
            </p>
          </div>

          <!-- Meta -->
          {ministry.meetingTime && (
            <p class="text-sm text-stone-500 font-medium mt-auto pt-4 border-t border-stone-200">
              <svg class="inline-block w-3.5 h-3.5 mr-1.5 align-middle text-burgundy-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              {ministry.meetingTime}
            </p>
          )}

          <!-- Link hint -->
          <p class="text-burgundy-700 text-sm font-semibold group-hover:text-burgundy-900">
            Learn more &rarr;
          </p>
        </Card>
      ))}
    </div>

    <!-- Bottom link -->
    <div class="mt-10 text-center">
      <Button href="/ministries/" variant="outline" size="md">
        See All Ministries
      </Button>
    </div>

  </div>
</section>
