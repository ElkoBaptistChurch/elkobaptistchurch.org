---
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const steps = [
  {
    icon: 'door',
    title: 'Come As You Are',
    body: "No dress code. No perfect past required. We mean it. God isn't waiting for you to have it all figured out — and neither are we. Just show up.",
  },
  {
    icon: 'people',
    title: 'Find Your People',
    body: "Small church means real relationships. You won't get lost in a crowd here. You'll know people's names, and they'll know yours — and that matters more than you might think.",
  },
  {
    icon: 'book',
    title: 'Hear God\'s Word',
    body: "Every Sunday, Pastor Wayne opens the Bible and preaches it straight — with warmth, with honesty, and with a shepherd's care for every soul in the room.",
  },
];
---

<section
  aria-label="For visitors and newcomers"
  class="bg-parchment section-py"
>
  <div class="section-container">
    <!-- Heading -->
    <div class="max-w-2xl mb-12 md:mb-16">
      <SectionHeading
        label="For First-Time Visitors"
        heading="New Here? You're in the Right Place."
        subheading="We're not a perfect church — nobody is. But we're a real one. And we'd love for you to come experience that for yourself."
      />
    </div>

    <!-- Three columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {steps.map((step) => (
        <div class="flex flex-col gap-4">
          <!-- Icon + title row -->
          <div class="flex items-center gap-4">
            <div
              class="w-14 h-14 rounded-full bg-burgundy-900 flex items-center justify-center flex-shrink-0"
              aria-hidden="true"
            >
              {step.icon === 'door' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-wheat-400" aria-hidden="true">
                  <path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/>
                  <path d="M8 22V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v18"/>
                </svg>
              )}
              {step.icon === 'people' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-wheat-400" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              )}
              {step.icon === 'book' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-wheat-400" aria-hidden="true">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              )}
            </div>

            <!-- Title -->
            <h3 class="font-display text-xl md:text-2xl font-bold text-stone-900 leading-snug">
              {step.title}
            </h3>
          </div>

          <!-- Body -->
          <p class="text-stone-600 leading-relaxed">
            {step.body}
          </p>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="border-t border-stone-200 pt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <p class="text-stone-600 text-lg">
        Ready to come see for yourself?
      </p>
      <Button href="/plan-your-visit/" variant="primary" size="md">
        Plan Your Visit &rarr;
      </Button>
    </div>
  </div>
</section>
