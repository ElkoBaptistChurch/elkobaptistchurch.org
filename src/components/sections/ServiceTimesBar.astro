---
import { siteConfig } from '@/data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section
  aria-label="Service times and location"
  class:list={['bg-burgundy-900 text-warm-white', compact ? 'py-4' : 'py-10 md:py-12']}
>
  <div class="section-container">
    <div class:list={['flex flex-col md:flex-row md:items-center gap-6 md:gap-0', compact ? 'md:gap-6' : 'md:gap-0']}>

      <!-- Label (hide in compact) -->
      {!compact && (
        <div class="md:w-48 flex-shrink-0">
          <p class="eyebrow text-wheat-400 mb-1">Join Us</p>
          <p class="font-display text-xl font-semibold text-warm-white leading-snug">
            We'd love to see you Sunday.
          </p>
        </div>
      )}

      <!-- Divider (hide in compact) -->
      {!compact && (
        <div class="hidden md:block w-px bg-burgundy-700 self-stretch mx-8" aria-hidden="true"></div>
      )}

      <!-- Service times -->
      <div class:list={[
        'flex flex-col sm:flex-row gap-4 sm:gap-6 flex-1',
        compact ? 'sm:gap-4' : 'sm:gap-6',
      ]}
        role="list"
        aria-label="Weekly service schedule"
      >
        {siteConfig.serviceTimes.map((service) => (
          <div role="listitem" class:list={['flex items-start gap-3', compact ? 'gap-2' : 'gap-3']}>
            <div class="w-1 flex-shrink-0 rounded-full bg-wheat-500 mt-1" style="height: 2.5em;" aria-hidden="true"></div>
            <div>
              <p class:list={['font-semibold text-warm-white leading-tight', compact ? 'text-sm' : 'text-base']}>
                {service.name}
              </p>
              <p class:list={['text-wheat-300', compact ? 'text-sm' : 'text-base']}>
                {service.day} &bull; {service.time}
              </p>
              {!compact && (
                <p class="text-burgundy-300 text-sm mt-0.5">{service.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Address + directions -->
      <div class:list={[
        'flex-shrink-0 flex flex-col gap-2',
        compact ? 'md:ml-6' : 'md:ml-8 md:border-l md:border-burgundy-700 md:pl-8',
      ]}>
        <p class:list={['text-burgundy-200', compact ? 'text-sm' : 'text-base']}>
          <svg class="inline-block w-4 h-4 mr-1.5 text-wheat-400 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {siteConfig.contact.address.full}
        </p>
        <a
          href={siteConfig.contact.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'inline-flex items-center gap-1.5 font-semibold text-wheat-400 hover:text-wheat-300 transition-colors underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-wheat-400',
            compact ? 'text-sm' : 'text-base',
          ]}
        >
          Get Directions
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span class="sr-only">(opens in Google Maps)</span>
        </a>
      </div>

    </div>
  </div>
</section>
