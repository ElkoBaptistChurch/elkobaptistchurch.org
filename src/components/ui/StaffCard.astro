---
interface Props {
  member: {
    id: string;
    name: string;
    title: string;
    bio: string;
    email?: string;
    image?: string | null;
  };
}

const { member } = Astro.props;
---

<article class="rounded-lg border border-stone-200 bg-warm-white overflow-hidden flex flex-col">
  <!-- Photo (portrait 3:4 aspect ratio) -->
  <div
    class="relative w-full bg-gradient-to-br from-burgundy-800 to-burgundy-950 overflow-hidden"
    style="aspect-ratio: 3/4;"
    data-photo-needed={`Portrait photo of ${member.name}, ${member.title}`}
  >
    {member.image ? (
      <img
        src={member.image}
        alt={`${member.name}, ${member.title} at Elko Baptist Church`}
        class="absolute inset-0 w-full h-full object-cover object-top"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center">
        <svg class="w-16 h-16 text-burgundy-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="text-burgundy-400 text-sm font-body">Photo coming soon</span>
      </div>
    )}

    <!-- Name overlay at bottom of photo -->
    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-burgundy-950/90 to-transparent px-5 pt-12 pb-4">
      <p class="font-display text-lg font-bold text-warm-white leading-tight">{member.name}</p>
      <p class="text-wheat-300 text-sm font-medium mt-0.5">{member.title}</p>
    </div>
  </div>

  <!-- Card body -->
  <div class="p-6 flex flex-col gap-4 flex-1">
    <p class="text-stone-600 text-base leading-relaxed">{member.bio}</p>

    {member.email && (
      <a
        href={`mailto:${member.email}`}
        class="inline-flex items-center gap-2 text-burgundy-800 font-semibold text-sm hover:text-burgundy-600 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-burgundy-700 rounded mt-auto"
        aria-label={`Email ${member.name}`}
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        {member.email}
      </a>
    )}
  </div>
</article>
