---
import type { Facet } from '@/utils/sermons';

interface Props {
  bookFacets: { ot: Facet[]; nt: Facet[] };
  topicFacets: Facet[];
}

const { bookFacets, topicFacets } = Astro.props;
---

<div
  id="sermon-filter"
  class="bg-warm-white border border-stone-200 rounded-xl p-5 md:p-6 mb-10 shadow-sm"
>
  <div class="flex flex-col md:flex-row gap-3 md:items-center">
    <!-- Search -->
    <div class="relative flex-1">
      <label for="sermon-search" class="sr-only">Search sermons</label>
      <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m21 21-4.3-4.3" /></svg>
      <input
        type="search"
        id="sermon-search"
        placeholder="Search a title, passage, or topic&hellip;"
        class="w-full pl-9 pr-3 py-2.5 bg-cream border border-stone-300 rounded-sm text-base text-stone-900 placeholder:text-stone-400 focus-visible:outline-2 focus-visible:outline-burgundy-700 focus:border-burgundy-700 transition-colors"
      />
    </div>

    <!-- Book -->
    {(bookFacets.ot.length > 0 || bookFacets.nt.length > 0) && (
      <div class="relative">
        <button type="button" id="sermon-book-btn" aria-expanded="false" aria-haspopup="listbox"
          class="w-full md:w-auto flex items-center justify-between gap-2 px-4 py-2.5 bg-cream border border-stone-300 rounded-sm text-base text-stone-700 hover:border-burgundy-700 focus-visible:outline-2 focus-visible:outline-burgundy-700">
          <span>Book <span id="sermon-book-val" class="text-burgundy-800 font-semibold"></span></span>
          <svg class="w-4 h-4 text-stone-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" /></svg>
        </button>
        <div id="sermon-book-menu" class="sf-menu hidden absolute right-0 mt-1 w-[420px] max-w-[85vw] max-h-[55vh] overflow-y-auto bg-warm-white border border-stone-200 rounded-md p-4 z-40">
          {bookFacets.ot.length > 0 && (
            <>
              <p class="eyebrow text-wheat-700 mb-2">Old Testament</p>
              <div class="sf-bookcol mb-4">
                {bookFacets.ot.map((f) => (
                  <button type="button" class="sf-bookitem" data-book={f.value}><span>{f.value}</span><span class="sf-c">{f.count}</span></button>
                ))}
              </div>
            </>
          )}
          {bookFacets.nt.length > 0 && (
            <>
              <p class="eyebrow text-wheat-700 mb-2">New Testament</p>
              <div class="sf-bookcol">
                {bookFacets.nt.map((f) => (
                  <button type="button" class="sf-bookitem" data-book={f.value}><span>{f.value}</span><span class="sf-c">{f.count}</span></button>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    )}

    <!-- Topic -->
    {topicFacets.length > 0 && (
      <div class="relative">
        <button type="button" id="sermon-topic-btn" aria-expanded="false" aria-haspopup="listbox"
          class="w-full md:w-auto flex items-center justify-between gap-2 px-4 py-2.5 bg-cream border border-stone-300 rounded-sm text-base text-stone-700 hover:border-burgundy-700 focus-visible:outline-2 focus-visible:outline-burgundy-700">
          <span>Topic <span id="sermon-topic-val" class="text-burgundy-800 font-semibold"></span></span>
          <svg class="w-4 h-4 text-stone-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" /></svg>
        </button>
        <div id="sermon-topic-menu" class="sf-menu hidden absolute right-0 mt-1 w-64 max-h-[55vh] overflow-y-auto bg-warm-white border border-stone-200 rounded-md p-2 z-40">
          {topicFacets.map((f) => (
            <button type="button" class="sf-bookitem" data-topic={f.value}><span>#{f.value}</span><span class="sf-c">{f.count}</span></button>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Active filters -->
  <div id="sermon-chiprow" class="hidden flex-wrap items-center gap-2 mt-4 pt-4 border-t border-stone-100">
    <span class="eyebrow text-stone-400">Filtering</span>
    <div id="sermon-chips" class="flex flex-wrap gap-2"></div>
    <button type="button" id="sermon-clear" class="text-sm text-burgundy-800 font-semibold hover:text-burgundy-600 ml-1 focus-visible:outline-2 focus-visible:outline-burgundy-700 rounded">Clear all</button>
  </div>
</div>

<style>
  .sf-bookcol { columns: 2; column-gap: 1.25rem; }
  .sf-bookitem {
    break-inside: avoid; display: flex; justify-content: space-between; gap: .75rem; width: 100%;
    padding: .2rem .4rem; border-radius: 3px; font-size: .85rem; color: var(--color-burgundy-900);
    cursor: pointer; background: none; border: 0; text-align: left;
  }
  .sf-bookitem:hover { background: var(--color-burgundy-50); }
  .sf-bookitem .sf-c { color: var(--color-wheat-700); font-weight: 700; font-size: .7rem; }
  .sf-menu { box-shadow: 0 10px 30px -12px rgba(60, 20, 30, .35); }
</style>

<script>
  function initSermonArchive() {
    const filter = document.getElementById('sermon-filter');
    const listEl = document.getElementById('sermon-list');
    if (!filter || !listEl) return;

    const rows = Array.from(document.querySelectorAll<HTMLElement>('.sermon-row'));
    const searchInput = document.getElementById('sermon-search') as HTMLInputElement | null;
    const sizeSelect = document.getElementById('sermon-size') as HTMLSelectElement | null;

    const heroSection = document.getElementById('sermon-heroes-section');
    const heroesEl = document.getElementById('sermon-heroes');
    const heroLabel = document.getElementById('sermon-hero-label');
    const heroHint = document.getElementById('sermon-hero-hint');

    const listSection = document.getElementById('sermon-list-section');
    const listLabel = document.getElementById('sermon-list-label');
    const countEl = document.getElementById('sermon-count');
    const emptyEl = document.getElementById('sermon-empty');
    const pager = document.getElementById('sermon-pager');

    const chipRow = document.getElementById('sermon-chiprow');
    const chipsEl = document.getElementById('sermon-chips');
    const clearBtn = document.getElementById('sermon-clear');

    const bookBtn = document.getElementById('sermon-book-btn');
    const bookMenu = document.getElementById('sermon-book-menu');
    const bookVal = document.getElementById('sermon-book-val');
    const topicBtn = document.getElementById('sermon-topic-btn');
    const topicMenu = document.getElementById('sermon-topic-menu');
    const topicVal = document.getElementById('sermon-topic-val');

    const HERO_COUNT = 6;
    let fQ = '', fBook = '', fTopic = '', page = 1;
    let pageSize = sizeSelect ? Number(sizeSelect.value) || 15 : 15;

    // ---- read initial state from URL ----
    const params = new URLSearchParams(location.search);
    fBook = params.get('book') || '';
    fTopic = params.get('topic') || '';
    fQ = (params.get('q') || '').toLowerCase();
    if (params.get('size') && sizeSelect) {
      const s = Number(params.get('size'));
      if ([15, 30, 50].includes(s)) { pageSize = s; sizeSelect.value = String(s); }
    }
    page = Math.max(1, Number(params.get('page')) || 1);
    if (searchInput && fQ) searchInput.value = fQ;

    const esc = (s: string) =>
      (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    function heroCard(d: DOMStringMap) {
      const video = d.video === '1';
      const dur = d.duration
        ? `<span class="flex-shrink-0 bg-stone-100 text-stone-600 text-xs font-body font-semibold px-2.5 py-1 rounded-full">${esc(d.duration)}</span>`
        : '';
      return `<article class="bg-warm-white rounded-lg border border-stone-200 overflow-hidden shadow-sm hover:shadow-md card-lift flex flex-col h-full">
        <div class="h-1 bg-gradient-to-r from-burgundy-700 to-burgundy-500" aria-hidden="true"></div>
        <div class="p-6 md:p-7 flex flex-col flex-1">
          <p class="font-display text-lg font-semibold text-burgundy-900 mb-1.5">${esc(d.scripture || '')}</p>
          <h3 class="font-display text-xl md:text-2xl font-bold text-stone-900 leading-snug mb-3">${esc(d.title || '')}</h3>
          <div class="flex items-center justify-between mb-4 gap-2">
            <p class="text-stone-500 text-sm font-body"><time datetime="${esc(d.iso || '')}" class="font-semibold text-stone-700">${esc(d.date || '')}</time></p>
            ${dur}
          </div>
          <p class="text-stone-600 text-base leading-relaxed mb-5 line-clamp-3 flex-1">${esc(d.desc || '')}</p>
          <div class="mt-auto border-t border-stone-100 pt-4 flex items-center justify-between gap-3">
            <a href="${esc(d.href || '#')}" class="inline-flex items-center gap-2 text-burgundy-800 font-body font-semibold text-sm hover:text-burgundy-600 transition-colors group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy-700 rounded">
              <span class="w-8 h-8 rounded-full bg-burgundy-50 border border-burgundy-200 flex items-center justify-center group-hover:bg-burgundy-100 transition-colors flex-shrink-0"><svg class="w-3.5 h-3.5 text-burgundy-800 ml-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
              ${video ? 'Watch Message' : 'Listen'}
            </a>
            <span class="text-stone-400 text-[0.7rem] font-body">${esc(d.speaker || '')}</span>
          </div>
        </div>
      </article>`;
    }

    function matches(row: HTMLElement) {
      if (fBook && row.dataset.book !== fBook) return false;
      if (fTopic && !(row.dataset.topics || '').split('|').includes(fTopic)) return false;
      if (fQ && !(row.dataset.search || '').includes(fQ)) return false;
      return true;
    }

    function pageWindow(cur: number, total: number) {
      const out: (number | '…')[] = [];
      for (let p = 1; p <= total; p++) {
        if (p === 1 || p === total || (p >= cur - 1 && p <= cur + 1)) out.push(p);
        else if (out[out.length - 1] !== '…') out.push('…');
      }
      return out;
    }

    function syncUrl() {
      const p = new URLSearchParams();
      if (fQ) p.set('q', fQ);
      if (fBook) p.set('book', fBook);
      if (fTopic) p.set('topic', fTopic);
      if (pageSize !== 15) p.set('size', String(pageSize));
      if (page > 1) p.set('page', String(page));
      const qs = p.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    function render() {
      const matching = rows.filter(matches);
      const searching = fQ !== '';
      const heroN = searching ? 0 : Math.min(HERO_COUNT, matching.length);
      const heroRows = matching.slice(0, heroN);
      const listRows = matching.slice(heroN);
      const noMatches = matching.length === 0;

      const totalPages = Math.max(1, Math.ceil(listRows.length / pageSize));
      if (page > totalPages) page = totalPages;
      const start = (page - 1) * pageSize;
      const end = Math.min(start + pageSize, listRows.length);

      rows.forEach((r) => { r.hidden = true; });
      for (let i = start; i < end; i++) listRows[i].hidden = false;

      // heroes
      if (heroesEl) heroesEl.innerHTML = heroRows.map((r) => heroCard(r.dataset)).join('');
      if (heroLabel) heroLabel.textContent = fBook ? `Latest in ${fBook}` : fTopic ? `Latest on #${fTopic}` : 'Most Recent';
      if (heroHint) heroHint.textContent = (fBook || fTopic) && !searching ? `${matching.length} total` : '';
      if (heroSection) heroSection.hidden = noMatches || heroN === 0;

      // list
      if (listSection) listSection.hidden = noMatches || listRows.length === 0;
      if (listLabel) listLabel.textContent = searching ? 'Search results' : heroN > 0 ? 'Earlier Messages' : 'Messages';
      if (countEl) countEl.textContent = listRows.length
        ? `Showing ${start + 1}–${end} of ${listRows.length}${searching ? ` result${listRows.length === 1 ? '' : 's'}` : ''}`
        : '';
      if (emptyEl) emptyEl.hidden = !noMatches;

      // pager
      if (pager) {
        pager.innerHTML = '';
        if (totalPages > 1) {
          const mk = (label: string, target: number, opts: { cur?: boolean; dis?: boolean } = {}) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = label;
            b.className = 'min-w-[2.25rem] h-9 inline-flex items-center justify-center border rounded text-sm transition-colors ' +
              (opts.cur ? 'bg-burgundy-900 text-warm-white border-burgundy-900 font-bold'
                        : 'bg-warm-white text-burgundy-900 border-stone-300 hover:border-burgundy-700') +
              (opts.dis ? ' opacity-40 cursor-default' : '');
            if (opts.cur) b.setAttribute('aria-current', 'page');
            if (opts.dis) b.disabled = true;
            else b.addEventListener('click', () => {
              page = target;
              render();
              listLabel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
            return b;
          };
          pager.appendChild(mk('‹ Prev', page - 1, { dis: page === 1 }));
          pageWindow(page, totalPages).forEach((p) => {
            if (p === '…') {
              const span = document.createElement('span');
              span.textContent = '…';
              span.className = 'px-1 text-stone-400';
              pager.appendChild(span);
            } else {
              pager.appendChild(mk(String(p), p, { cur: p === page }));
            }
          });
          pager.appendChild(mk('Next ›', page + 1, { dis: page === totalPages }));
        }
      }

      // chips
      const active = Boolean(fQ || fBook || fTopic);
      if (chipRow) { chipRow.hidden = !active; chipRow.classList.toggle('flex', active); }
      if (chipsEl) {
        chipsEl.innerHTML = '';
        const addChip = (label: string, onRemove: () => void) => {
          const span = document.createElement('span');
          span.className = 'inline-flex items-center gap-1.5 bg-burgundy-900 text-warm-white text-xs font-semibold px-2.5 py-1 rounded-full';
          const txt = document.createElement('span');
          txt.textContent = label;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = '✕';
          btn.setAttribute('aria-label', `Remove ${label} filter`);
          btn.className = 'text-burgundy-200 hover:text-warm-white';
          btn.addEventListener('click', onRemove);
          span.append(txt, btn);
          chipsEl.appendChild(span);
        };
        if (fBook) addChip(fBook, () => { fBook = ''; reset(); });
        if (fTopic) addChip('#' + fTopic, () => { fTopic = ''; reset(); });
        if (fQ) addChip(`“${fQ}”`, () => { fQ = ''; if (searchInput) searchInput.value = ''; reset(); });
      }
      if (bookVal) bookVal.textContent = fBook ? `· ${fBook}` : '';
      if (topicVal) topicVal.textContent = fTopic ? `· #${fTopic}` : '';
      if (bookBtn) bookBtn.setAttribute('aria-expanded', String(!bookMenu?.classList.contains('hidden')));
      if (topicBtn) topicBtn.setAttribute('aria-expanded', String(!topicMenu?.classList.contains('hidden')));

      syncUrl();
    }

    function reset() { page = 1; render(); }

    // ---- events ----
    searchInput?.addEventListener('input', () => { fQ = searchInput.value.trim().toLowerCase(); reset(); });
    sizeSelect?.addEventListener('change', () => { pageSize = Number(sizeSelect.value) || 15; reset(); });
    clearBtn?.addEventListener('click', () => { fQ = fBook = fTopic = ''; if (searchInput) searchInput.value = ''; reset(); });

    function closeMenus() { bookMenu?.classList.add('hidden'); topicMenu?.classList.add('hidden'); }
    function wireMenu(btn: HTMLElement | null, menu: HTMLElement | null) {
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !menu?.classList.contains('hidden');
        closeMenus();
        if (!open) menu?.classList.remove('hidden');
        btn.setAttribute('aria-expanded', String(!open));
      });
    }
    wireMenu(bookBtn, bookMenu);
    wireMenu(topicBtn, topicMenu);
    document.addEventListener('click', closeMenus);
    bookMenu?.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('[data-book]');
      if (item) { fBook = item.dataset.book || ''; closeMenus(); reset(); }
      e.stopPropagation();
    });
    topicMenu?.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('[data-topic]');
      if (item) { fTopic = item.dataset.topic || ''; closeMenus(); reset(); }
      e.stopPropagation();
    });

    render();
  }

  initSermonArchive();
</script>
