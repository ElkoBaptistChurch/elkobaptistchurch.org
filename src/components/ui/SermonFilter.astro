---
interface RecentPill {
  type: 'book' | 'tag';
  value: string;
}

interface ComboboxOption {
  value: string;
  label: string;
}

interface Props {
  years: string[]; // e.g. "2026Sermons"
  books: string[];
  recentPills?: RecentPill[];
  pageSize?: number;
}

const { years, books, recentPills = [], pageSize = 24 } = Astro.props;

const bookOptions: ComboboxOption[] = books.map((b) => ({ value: b, label: b }));
const yearOptions: ComboboxOption[] = years.map((y) => ({ value: y, label: y.replace('Sermons', '') }));
---

<div
  id="sermon-filter"
  data-page-size={pageSize}
  class="bg-warm-white border border-stone-200 rounded-xl p-5 md:p-6 mb-8 flex flex-col gap-4"
>
  <div class="flex flex-col md:flex-row gap-4 md:items-end">
    <div class="flex-1 flex flex-col gap-1.5">
      <label for="sermon-search" class="font-body font-medium text-stone-800 text-sm">
        Search sermons
      </label>
      <input
        type="search"
        id="sermon-search"
        placeholder="Search by title, scripture, or topic&hellip;"
        class="w-full px-4 py-2.5 text-stone-900 bg-cream border border-stone-300 rounded-sm text-base
               focus-visible:outline-2 focus-visible:outline-burgundy-700 focus:border-burgundy-700
               placeholder:text-stone-400 transition-colors"
      />
    </div>

    <div class="flex flex-wrap gap-3">
      {bookOptions.length > 0 && (
        <div class="flex flex-col gap-1.5">
          <label for="sermon-filter-book" class="font-body font-medium text-stone-800 text-sm">Book</label>
          <div class="relative w-40" data-combobox data-filter-mode="exact">
            <input
              type="text"
              id="sermon-filter-book"
              role="combobox"
              aria-expanded="false"
              aria-controls="sermon-book-listbox"
              aria-autocomplete="list"
              autocomplete="off"
              placeholder="All books"
              class="w-full pl-3 pr-9 py-2.5 text-stone-900 bg-cream border border-stone-300 rounded-sm text-base
                     focus-visible:outline-2 focus-visible:outline-burgundy-700 focus:border-burgundy-700
                     placeholder:text-stone-400"
            />
            <svg
              class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
            </svg>
            <ul
              id="sermon-book-listbox"
              role="listbox"
              class="hidden absolute z-20 left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-warm-white
                     border border-stone-200 rounded-sm shadow-md py-1"
            >
              {bookOptions.map((opt) => (
                <li role="option" data-value={opt.value} data-label={opt.label} tabindex="-1" class="px-3 py-2 text-stone-800 text-base cursor-pointer hover:bg-burgundy-50 aria-selected:bg-burgundy-50 aria-selected:font-semibold">
                  {opt.label}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      {yearOptions.length > 0 && (
        <div class="flex flex-col gap-1.5">
          <label for="sermon-filter-year" class="font-body font-medium text-stone-800 text-sm">Year</label>
          <div class="relative w-32" data-combobox data-filter-mode="exact">
            <input
              type="text"
              id="sermon-filter-year"
              role="combobox"
              aria-expanded="false"
              aria-controls="sermon-year-listbox"
              aria-autocomplete="list"
              autocomplete="off"
              placeholder="All years"
              class="w-full pl-3 pr-9 py-2.5 text-stone-900 bg-cream border border-stone-300 rounded-sm text-base
                     focus-visible:outline-2 focus-visible:outline-burgundy-700 focus:border-burgundy-700
                     placeholder:text-stone-400"
            />
            <svg
              class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
            </svg>
            <ul
              id="sermon-year-listbox"
              role="listbox"
              class="hidden absolute z-20 left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-warm-white
                     border border-stone-200 rounded-sm shadow-md py-1"
            >
              {yearOptions.map((opt) => (
                <li role="option" data-value={opt.value} data-label={opt.label} tabindex="-1" class="px-3 py-2 text-stone-800 text-base cursor-pointer hover:bg-burgundy-50 aria-selected:bg-burgundy-50 aria-selected:font-semibold">
                  {opt.label}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </div>
  </div>

  {recentPills.length > 0 && (
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="font-body font-medium text-stone-500 text-xs uppercase tracking-wide mr-1">
        Recent:
      </span>
      {recentPills.map((pill) => (
        <button
          type="button"
          data-sermon-pill
          data-type={pill.type}
          data-value={pill.value}
          aria-pressed="false"
          class="bg-cream border border-stone-300 text-stone-700 font-body text-xs px-2.5 py-1 rounded-full
                 hover:border-burgundy-700 hover:text-burgundy-800 transition-colors
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy-700
                 aria-pressed:bg-burgundy-900 aria-pressed:border-burgundy-900 aria-pressed:text-warm-white"
        >
          {pill.type === 'tag' ? `#${pill.value}` : pill.value}
        </button>
      ))}
    </div>
  )}

  <p id="sermon-result-count" class="text-stone-500 text-sm" aria-live="polite"></p>
</div>

<script>
  // Backing value for each combobox, keyed by input id. For "exact" mode
  // comboboxes (Book, Year) this only updates when an option is actually
  // chosen; for "substring" mode (Series) it tracks the typed text live.
  type ComboboxHandle = { getValue: () => string; setValue: (value: string) => void };

  function setupCombobox(wrapper: HTMLElement, onChange: () => void): ComboboxHandle {
    const input = wrapper.querySelector('input') as HTMLInputElement;
    const listbox = wrapper.querySelector('ul[role="listbox"]') as HTMLUListElement;
    const options = Array.from(listbox.querySelectorAll<HTMLLIElement>('[role="option"]'));
    const mode = wrapper.dataset.filterMode === 'exact' ? 'exact' : 'substring';

    let activeIndex = -1;
    let selectedValue = '';

    function visibleOptions() {
      return options.filter((opt) => !opt.classList.contains('hidden'));
    }

    function setActive(index: number) {
      const visible = visibleOptions();
      visible.forEach((opt) => opt.removeAttribute('aria-selected'));
      activeIndex = index;
      const target = visible[index];
      if (target) {
        target.setAttribute('aria-selected', 'true');
        target.scrollIntoView({ block: 'nearest' });
      }
    }

    function openListbox() {
      listbox.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    }

    function closeListbox() {
      listbox.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
      options.forEach((opt) => opt.removeAttribute('aria-selected'));
    }

    function filterOptions() {
      const query = input.value.trim().toLowerCase();
      options.forEach((opt) => {
        const text = (opt.dataset.label || opt.dataset.value || '').toLowerCase();
        opt.classList.toggle('hidden', !text.includes(query));
      });
    }

    function chooseOption(opt: HTMLLIElement) {
      input.value = opt.dataset.label || opt.dataset.value || '';
      selectedValue = opt.dataset.value || '';
      closeListbox();
      onChange();
    }

    input.addEventListener('focus', () => {
      filterOptions();
      openListbox();
    });

    input.addEventListener('input', () => {
      filterOptions();
      openListbox();
      if (mode === 'substring') {
        onChange();
      } else if (input.value.trim() === '') {
        selectedValue = '';
        onChange();
      }
    });

    input.addEventListener('keydown', (e) => {
      const visible = visibleOptions();
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (listbox.classList.contains('hidden')) openListbox();
        setActive(Math.min(activeIndex + 1, visible.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(Math.max(activeIndex - 1, 0));
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && visible[activeIndex]) {
          e.preventDefault();
          chooseOption(visible[activeIndex]);
        }
      } else if (e.key === 'Escape') {
        closeListbox();
      }
    });

    options.forEach((opt) => {
      opt.addEventListener('mousedown', (e) => e.preventDefault());
      opt.addEventListener('click', () => chooseOption(opt));
    });

    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) {
        // Exact-mode combos: if the user typed text but never picked an
        // option, snap the displayed text back to whatever is actually
        // selected (or blank, if nothing is).
        if (mode === 'exact') {
          const selectedOpt = options.find((o) => o.dataset.value === selectedValue);
          input.value = selectedOpt ? (selectedOpt.dataset.label || selectedValue) : '';
        }
        closeListbox();
      }
    });

    return {
      getValue: () => (mode === 'substring' ? input.value.trim().toLowerCase() : selectedValue),
      setValue: (value: string) => {
        const opt = options.find((o) => o.dataset.value === value);
        input.value = opt ? (opt.dataset.label || value) : value;
        selectedValue = value;
      },
    };
  }

  function initSermonFilter() {
    const root = document.getElementById('sermon-filter');
    const grid = document.getElementById('sermon-grid');
    if (!root || !grid) return;

    const pageSize = Number(root.dataset.pageSize) || 24;
    const searchInput = document.getElementById('sermon-search') as HTMLInputElement | null;
    const resultCount = document.getElementById('sermon-result-count');
    const loadMoreBtn = document.getElementById('sermon-load-more') as HTMLButtonElement | null;
    const emptyState = document.getElementById('sermon-empty-state');
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sermon-pill]'));

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-sermon-card]'));

    let visibleCount = pageSize;

    function matches(card: HTMLElement, query: string, book: string, year: string) {
      const tags = (card.dataset.tags || '').split('|');
      if (book && !tags.includes(book)) return false;
      if (year && !tags.includes(year)) return false;
      if (query) {
        const haystack = card.dataset.search || '';
        if (!haystack.includes(query)) return false;
      }
      return true;
    }

    function updatePillStates(book: string, query: string) {
      pills.forEach((pill) => {
        const { type, value } = pill.dataset;
        const valueLower = (value || '').toLowerCase();
        let active = false;
        if (type === 'book') active = book === value;
        else active = query === valueLower;
        pill.setAttribute('aria-pressed', String(active));
      });
    }

    function render() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const book = bookCombobox?.getValue() || '';
      const year = yearCombobox?.getValue() || '';

      let shown = 0;
      let matched = 0;

      cards.forEach((card) => {
        const isMatch = matches(card, query, book, year);
        if (isMatch) matched += 1;
        const shouldShow = isMatch && matched <= visibleCount;
        card.classList.toggle('hidden', !shouldShow);
        if (shouldShow) shown += 1;
      });

      if (resultCount) {
        resultCount.textContent = matched === 0
          ? 'No sermons match your search.'
          : `Showing ${shown} of ${matched} sermon${matched === 1 ? '' : 's'}`;
      }

      if (loadMoreBtn) {
        loadMoreBtn.classList.toggle('hidden', matched <= visibleCount);
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', matched !== 0);
      }

      updatePillStates(book, query);
    }

    function onFilterChange() {
      visibleCount = pageSize;
      render();
    }

    const bookWrapper = document.querySelector('#sermon-filter-book')?.closest('[data-combobox]') as HTMLElement | null;
    const yearWrapper = document.querySelector('#sermon-filter-year')?.closest('[data-combobox]') as HTMLElement | null;

    const bookCombobox = bookWrapper ? setupCombobox(bookWrapper, onFilterChange) : null;
    const yearCombobox = yearWrapper ? setupCombobox(yearWrapper, onFilterChange) : null;

    searchInput?.addEventListener('input', onFilterChange);

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const { type, value } = pill.dataset;
        const alreadyActive = pill.getAttribute('aria-pressed') === 'true';
        const newValue = alreadyActive ? '' : (value || '');

        if (type === 'book') {
          bookCombobox?.setValue(newValue);
        } else if (searchInput) {
          searchInput.value = newValue;
        }

        onFilterChange();
      });
    });

    loadMoreBtn?.addEventListener('click', () => {
      visibleCount += pageSize;
      render();
    });

    render();
  }

  initSermonFilter();
</script>
