---
interface Props {
  ministry: {
    id: string;
    name: string;
    shortDescription: string;
    audience: string;
    meetingTime?: string;
    icon: string; // 'music' | 'book' | 'children' | 'men' | 'women' | 'outreach' | 'prayer' | 'online'
  };
  featured?: boolean;
}

const { ministry, featured = false } = Astro.props;
---

<div
  class={`rounded-lg border border-stone-200 overflow-hidden card-lift flex flex-col ${featured ? 'bg-warm-white' : 'bg-parchment'}`}
>
  <!-- Icon header strip -->
  <div class="bg-burgundy-900 px-6 py-5 flex items-center gap-4">
    <div class="flex-shrink-0 w-11 h-11 rounded-full bg-burgundy-800 flex items-center justify-center text-wheat-400">
      {ministry.icon === 'music' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
      )}
      {ministry.icon === 'book' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      )}
      {ministry.icon === 'children' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )}
      {ministry.icon === 'men' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      )}
      {ministry.icon === 'women' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      )}
      {ministry.icon === 'outreach' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )}
      {ministry.icon === 'prayer' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
        </svg>
      )}
      {ministry.icon === 'online' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      )}
    </div>
    <h3 class="font-display text-lg font-bold text-warm-white leading-tight">{ministry.name}</h3>
  </div>

  <!-- Card body -->
  <div class="p-6 flex flex-col flex-1 gap-4">
    <!-- Audience badge -->
    <span class="inline-flex items-center self-start px-3 py-1 rounded-full text-xs font-semibold bg-burgundy-100 text-burgundy-800 uppercase tracking-wide">
      {ministry.audience}
    </span>

    <p class="text-stone-600 text-base leading-relaxed flex-1">{ministry.shortDescription}</p>

    {ministry.meetingTime && (
      <div class="flex items-center gap-2 text-sm text-stone-500">
        <svg class="w-4 h-4 flex-shrink-0 text-wheat-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{ministry.meetingTime}</span>
      </div>
    )}

    <a
      href={`/ministries/#${ministry.id}`}
      class="inline-flex items-center gap-1.5 text-burgundy-800 font-semibold text-sm hover:text-burgundy-600 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-burgundy-700 rounded"
      aria-label={`Learn more about ${ministry.name}`}
    >
      Learn More
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</div>
